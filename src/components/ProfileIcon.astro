---
interface Props { name?: string }
const { name = 'link' } = Astro.props;
const icon = name.toLowerCase();
---

<span class:list={['profile-icon', `profile-icon--${icon}`]} aria-hidden="true">
  {icon === 'scholar' ? (
    <svg viewBox="0 0 24 24"><path d="m3 8.5 9-4 9 4-9 4-9-4Z"/><path d="M6.5 10.1v4.1c0 1.6 2.5 2.9 5.5 2.9s5.5-1.3 5.5-2.9v-4.1"/><path d="M21 8.7v5"/></svg>
  ) : icon === 'orcid' ? (
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M8.8 10v5.7M8.8 7.8h.01M12.4 10h1.8c1.8 0 3 1.2 3 2.9s-1.2 2.9-3 2.9h-1.8V10Z"/></svg>
  ) : icon === 'university' ? (
    <svg viewBox="0 0 24 24"><path d="m4 9 8-4.3L20 9M5 9.5h14M7 10v7M10.3 10v7M13.7 10v7M17 10v7M5 17.5h14M3.8 20h16.4"/></svg>
  ) : icon === 'network' ? (
    <svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="2.2"/><circle cx="17.5" cy="6.5" r="2.2"/><circle cx="17.5" cy="17.5" r="2.2"/><path d="m8 11 7.5-3.6M8 13l7.5 3.6"/></svg>
  ) : icon === 'research' ? (
    <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m14.6 14.6 4.7 4.7M8 10.5h5M10.5 8v5"/></svg>
  ) : icon === 'email' ? (
    <svg viewBox="0 0 24 24"><path d="M4 6.8h16v10.4H4Z"/><path d="m5 8 7 5 7-5"/></svg>
  ) : icon === 'cv' ? (
    <svg viewBox="0 0 24 24"><path d="M6.5 3.8h7l4 4v12.4h-11V3.8Z"/><path d="M13.5 3.8v4h4M9 12h6M9 15h6M9 18h3.5"/></svg>
  ) : (
    <svg viewBox="0 0 24 24"><path d="m9 15 6-6M10.5 5.5l1.2-1.2a4 4 0 0 1 5.7 5.7l-1.2 1.2M13.5 18.5l-1.2 1.2A4 4 0 0 1 6.6 14l1.2-1.2"/></svg>
  )}
</span>

<style>
  .profile-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--rule));
    border-radius: var(--radius);
  }
  .profile-icon svg { width: 1.05rem; height: 1.05rem; }
  .profile-icon path,
  .profile-icon circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .profile-icon--orcid {
    color: #5c7f32;
    background: #eef2e5;
    border-color: #cfdbbc;
    border-radius: 999px;
  }
  :global([data-theme='dark']) .profile-icon--orcid {
    color: #afd276;
    background: rgba(142, 183, 85, 0.12);
    border-color: rgba(142, 183, 85, 0.3);
  }
</style>
