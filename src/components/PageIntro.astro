---
interface Props { index: string; eyebrow: string; title: string; summary: string }
const { index, eyebrow, title, summary } = Astro.props;
---
<header class="page-intro">
  <div class="page-index mono"><span>{index}</span><span aria-hidden="true"></span></div>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-summary">{summary}</p>
  </div>
</header>

<style>
  .page-intro {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .page-index { display: grid; gap: 0.75rem; color: var(--signal); font-size: 0.75rem; letter-spacing: 0.08em; padding-top: 0.4rem; }
  .page-index span:last-child { width: 100%; height: 1px; background: var(--signal); }
  h1 { font-size: var(--step-5); margin-top: 0.45rem; }
  .page-summary { max-width: 58ch; margin-top: 1.3rem; font-family: var(--font-serif); font-size: var(--step-1); line-height: 1.5; color: var(--ink-soft); }
  @media (max-width: 34rem) {
    .page-intro { grid-template-columns: 1fr; gap: 0.8rem; }
    .page-index { grid-template-columns: auto 1fr; align-items: center; }
  }
</style>
