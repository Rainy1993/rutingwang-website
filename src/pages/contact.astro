---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileIcon from '../components/ProfileIcon.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = `Contact ${site.name} and find verified academic profiles, institutional email addresses and a downloadable CV.`;
---
<BaseLayout title="Contact" description={description}>
  <div class="page-shell">
    <div class="container">
      <div class="contact-grid">
        <section class="contact-card card" aria-labelledby="direct-title">
          <p class="eyebrow">Direct</p><h2 id="direct-title">Email</h2>
          <dl>
            <div><dt>City University of Hong Kong</dt><dd><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            <div><dt>Sun Yat-sen University</dt><dd><a class="text-link" href={`mailto:${site.emailSecondary}`}>{site.emailSecondary}</a></dd></div>
            <div><dt>Affiliations</dt><dd>School of Energy and Environment, City University of Hong Kong<br/>Business School, Sun Yat-sen University</dd></div>
          </dl>
        </section>

        <section class="contact-card card" aria-labelledby="profiles-title">
          <p class="eyebrow">Elsewhere</p><h2 id="profiles-title">Academic profiles</h2>
          <ul class="profile-list" role="list">
            {site.profiles.map((profile) => (
              <li><a href={profile.href} target="_blank" rel="me noopener noreferrer"><ProfileIcon name={profile.icon}/><span><strong>{profile.label}</strong><small>{new URL(profile.href).host}</small></span><span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
            ))}
            <li><a href={`${base}/docs/ruting-wang-cv.pdf`} target="_blank" rel="noopener noreferrer"><ProfileIcon name="cv"/><span><strong>Curriculum vitae</strong><small>PDF · complete current CV</small></span><span aria-hidden="true">↓</span><span class="visually-hidden"> (PDF, opens in a new tab)</span></a></li>
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(19rem,0.85fr); gap: 1rem; }
  .contact-card { padding: clamp(1.5rem,4vw,2.5rem); }
  .contact-card:first-child { border-top: 3px solid var(--signal); }
  .contact-card h2 { margin-top: 0.45rem; font-size: var(--step-2); }
  dl { margin-top: 1.5rem; border-top: 1px solid var(--rule); }
  dl > div { display: grid; grid-template-columns: 12rem minmax(0,1fr); gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--rule); }
  dt { color: var(--muted); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; }
  dd { color: var(--ink-soft); overflow-wrap: anywhere; }
  .profile-list { margin-top: 1.2rem; border-top: 1px solid var(--rule); }
  .profile-list a { display: grid; grid-template-columns: 2rem minmax(0,1fr) auto; gap: 0.8rem; align-items: center; padding-block: 0.75rem; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .profile-list a:hover strong { color: var(--accent); }
  .profile-list strong { display: block; font-size: 0.9rem; font-weight: 620; }
  .profile-list small { display: block; margin-top: 0.08rem; color: var(--muted); font-family: var(--font-mono); font-size: 0.63rem; overflow-wrap: anywhere; }
  @media (max-width: 49rem) { .contact-grid { grid-template-columns: 1fr; } }
  @media (max-width: 34rem) { dl > div { grid-template-columns: 1fr; gap: 0.3rem; } }
</style>
