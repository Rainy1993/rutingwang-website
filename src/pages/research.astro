---
import BaseLayout from '../layouts/BaseLayout.astro';
import TalksSection from '../components/TalksSection.astro';
import { researchThemes, grants } from '../data/research';
import { workingPapers } from '../data/publications';
import { site } from '../data/site';

const networks = [
  {
    title: 'Laboratory of Energy Economics and Environmental Management',
    description:
      'Member since December 2024. E3M is committed to exploring the dynamic interplay among economic systems, energy transitions, and environmental sustainability.',
    href: 'https://www.cityu.edu.hk/see_eeem/index.html',
    cta: 'View E3M website',
  },
  {
    title: 'MSCA Digital Finance',
    description: 'Member since August 2025. The network brings together academic and industry perspectives on digital finance.',
    href: 'https://www.digital-finance-msca.com/people/ruting-wang',
    cta: 'View MSCA profile',
  },
  {
    title: 'Institute for Digital Assets',
    description:
      'Member since December 2023. Global research and educational institution dedicated to advancing the understanding, adoption, and integration of digital assets into the economy and society.',
    href: 'https://www.theida.net/',
    cta: 'View IDA profile',
  },
];
const description = `Research by ${site.name} on systemic risk, digital assets, climate finance, corporate finance and machine learning.`;
---
<BaseLayout title="Research" description={description}>
  <div class="page-shell">
    <div class="container">
      <section class="themes content-block" aria-labelledby="themes-title">
        <header class="section-heading"><div><p class="eyebrow">Themes</p><h2 id="themes-title">Research topics</h2></div></header>
        <ul class="theme-list" role="list">
          {researchThemes.map((theme) => (
            <li id={`theme-${theme.ref}`}>
              <article class="theme-card">
                <span class="theme-ref mono">{theme.ref}</span>
                <h3>{theme.title}</h3>
                <ul role="list">
                  {theme.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="content-block network-section" aria-labelledby="network-title">
        <header class="section-heading"><div><p class="eyebrow">Research network</p><h2 id="network-title">International networks</h2></div></header>
        <div class="network-grid">
          {networks.map((network) => (
            <article class="network-card">
              <h3>{network.title}</h3>
              <p>{network.description}</p>
              <a class="button secondary" href={network.href} target="_blank" rel="noopener noreferrer">{network.cta} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="content-block" aria-labelledby="grants-title">
        <header class="section-heading"><div><p class="eyebrow">Funded research</p><h2 id="grants-title">Projects as principal investigator</h2></div></header>
        <div class="grant-list">
          {grants.map((grant) => (
            <article class="grant"><div class="grant-meta"><span class="mono">{grant.period}</span></div><div><p class="grant-funder">{grant.funder} · {grant.id}</p><h3>{grant.title}</h3></div></article>
          ))}
        </div>
      </section>

      <section class="content-block" aria-labelledby="working-title">
        <header class="section-heading"><div><p class="eyebrow">Current pipeline</p><h2 id="working-title">Research in progress</h2></div></header>
        <div class="working-grid">
          {workingPapers.map((paper) => (
            <article class="work-card card"><p class="mono work-status">{paper.status}</p><h3>{paper.href ? <a class="text-link" href={paper.href} target="_blank" rel="noopener noreferrer">{paper.title}<span class="visually-hidden"> (opens in a new tab)</span></a> : paper.title}</h3><p>{paper.authors}</p><p class="work-venue">{paper.venue}</p></article>
          ))}
        </div>
      </section>

      <TalksSection/>
    </div>
  </div>
</BaseLayout>

<style>
  .theme-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .theme-list > li { scroll-margin-top: var(--header-offset); }
  .theme-card { height: 100%; padding: clamp(1.35rem,3vw,2rem); border: 1px solid var(--rule); border-top: 3px solid var(--signal); background: var(--surface); }
  .theme-ref { color: var(--signal); font-size: 0.68rem; letter-spacing: 0.08em; }
  .theme-card h3 { margin-top: 0.8rem; font-size: clamp(1.35rem,1.25rem + 0.48vw,1.65rem); font-weight: 570; letter-spacing: -0.012em; line-height: 1.3; text-wrap: wrap; }
  .theme-card ul { display: grid; gap: 0.65rem; margin-top: 1rem; padding-left: 1.1rem; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.6; }
  .theme-card li::marker { color: var(--signal); }
  .network-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .network-card { display: grid; align-content: start; gap: 1rem; padding: clamp(1.5rem,4vw,2.7rem); background: var(--accent-soft); border: 1px solid var(--rule); }
  .network-card h3 { font-size: var(--step-2); }
  .network-card p { color: var(--ink-soft); }
  .network-card .button { justify-self: start; }
  .grant-list { border-top: 1px solid var(--rule); }
  .grant { display: grid; grid-template-columns: 12rem minmax(0,1fr); gap: clamp(1.2rem,4vw,3rem); padding-block: 1.6rem; border-bottom: 1px solid var(--rule); }
  .grant-meta { display: grid; align-content: start; gap: 0.25rem; color: var(--muted); font-size: 0.75rem; }
  .grant-meta .mono { color: var(--signal); }
  .grant-funder { color: var(--copper); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .grant h3 { max-width: 100%; margin-top: 0.45rem; font-size: var(--step-1); line-height: 1.35; text-wrap: wrap; }
  .working-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0.85rem; }
  .work-card { padding: 1.25rem; }
  .work-status { color: var(--copper); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .work-card h3 { margin-top: 0.55rem; font-size: 1.08rem; line-height: 1.33; }
  .work-card > p:nth-last-child(2) { margin-top: 0.65rem; color: var(--ink-soft); font-size: 0.84rem; }
  .work-venue { margin-top: 0.25rem; color: var(--muted); font-family: var(--font-serif); font-size: 0.9rem; font-style: italic; }
  @media (max-width: 46rem) { .theme-list, .working-grid, .network-grid { grid-template-columns: 1fr; } .grant { grid-template-columns: 1fr; gap: 0.6rem; } }
</style>
