---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  fullTitle?: string;
  image?: string;
  type?: 'website' | 'profile' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  fullTitle,
  image = '/og/ruting-wang-og.png',
  type = 'website',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const pageTitle = fullTitle ?? `${title} · ${site.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(withBase(image), Astro.site).href : undefined;
const rootUrl = Astro.site ? new URL(base || '/', Astro.site).href : undefined;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.nameZh,
  honorificPrefix: site.honorific,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  ...(rootUrl ? { url: rootUrl } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  affiliation: [
    { '@type': 'CollegeOrUniversity', name: 'City University of Hong Kong' },
    { '@type': 'CollegeOrUniversity', name: 'Sun Yat-sen University' },
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'ORCID',
    value: 'https://orcid.org/0000-0001-8871-3838',
  },
  sameAs: site.profiles.map((profile) => profile.href),
  knowsAbout: site.researchAreas,
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<script is:inline>
  (function () {
    try {
      var saved = localStorage.getItem('rw-theme');
      var dark = saved === 'dark' || (saved !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (dark) document.documentElement.dataset.theme = 'dark';
    } catch (error) {}
  })();
</script>

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta name="theme-color" content="#f6f2eb" />
<meta name="color-scheme" content="light dark" />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="manifest" href={withBase('/site.webmanifest')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
{ogImage && <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />}
<meta property="og:locale" content="en_GB" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{Astro.site && <link rel="sitemap" href={withBase('/sitemap-index.xml')} />}
<script type="application/ld+json" set:html={JSON.stringify(personLd)} is:inline />
