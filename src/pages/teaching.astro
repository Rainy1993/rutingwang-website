---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const teaching = [
  { period: 'August 2025', course: 'Machine Learning in Financial Risk', institution: 'Data without Borders: Building AI Competence across Borders · Romania', detail: 'Summer course' },
  { period: 'Feb–Sep 2021', course: 'DEDA — Digital Economy & Decision Analytics', institution: 'Humboldt-Universität zu Berlin', detail: '' },
  { period: 'Sep–Dec 2019', course: 'Probability Theory', institution: 'Sun Yat-sen University', detail: '' },
  { period: 'Sep–Dec 2019', course: 'Financial Markets and Financial Institutions', institution: 'Sun Yat-sen University', detail: '' },
];
const quantinar = [
  { title: 'Machine Learning in Financial Risk', description: 'Risk measures, quantile regression, penalised methods and Financial Risk Meter applications.', href: 'https://quantinar.com/course/934/machine-learning-in-financial-risk' },
  { title: 'FRM@China', description: 'A systemic financial risk indicator for China using tail-event dependence and quantile-LASSO methods.', href: 'https://www.quantinar.com/course/43/FRM' },
  { title: 'Measuring Carbon Risk Dynamics', description: 'A courselet on a dynamic carbon-risk indicator and the low-carbon premium.', href: 'https://quantinar.com/course/923/measuring-carbon-risk-dynamics?q=cardi' },
  { title: 'Market Responses to ETH Development Milestones', description: 'The market effects of Ethereum upgrades and protocol innovation.', href: 'https://quantinar.com/course/857/market-responses-to-eth-development-milestones' },
  { title: 'Kalman Filter', description: 'An introduction to the method, its calculation and applications.', href: 'https://www.quantinar.com/course/42/methodology' },
];
const description = `Teaching by ${site.name} in financial risk, machine learning, probability, financial markets and digital-economy analytics.`;
---
<BaseLayout title="Teaching" description={description}>
  <div class="page-shell">
    <div class="container">
      <section class="content-block teaching-block" aria-labelledby="experience-title">
        <header class="section-heading"><div><p class="eyebrow">Classroom</p><h2 id="experience-title">Teaching experience</h2></div><p class="section-note">Teaching roles and dates reported in the July 2026 CV.</p></header>
        <div class="timeline">
          {teaching.map((item) => <article class="timeline-item"><p class="timeline-date mono">{item.period}</p><div><h3>{item.course}</h3><p>{item.institution}</p>{item.detail && <p class="muted">{item.detail}</p>}</div></article>)}
        </div>
      </section>

      <section class="content-block" aria-labelledby="online-title">
        <header class="section-heading"><div><p class="eyebrow">Open learning</p><h2 id="online-title">Quantinar courses &amp; courselets</h2></div><p class="section-note">Verified public course pages created by Ruting Wang. Each link opens the course on Quantinar.</p></header>
        <div class="course-grid">
          {quantinar.map((course, index) => (
            <a class="course-card card" href={course.href} target="_blank" rel="noopener noreferrer">
              <span class="course-index mono">Q / {String(index + 1).padStart(2, '0')}</span><h3>{course.title}</h3><p>{course.description}</p><span class="course-link">Open course <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></span>
            </a>
          ))}
        </div>
      </section>

      <section class="content-block methods" aria-labelledby="topics-title">
        <div><p class="eyebrow">Additional courselets</p><h2 id="topics-title">Topics listed in the CV</h2></div>
        <ul role="list"><li>Applied time-series solutions</li><li>Pricing-kernel puzzle</li><li>Quantile regression</li><li>Financial Risk Meter for China and crypto markets</li><li>Expectation Maximisation algorithm</li></ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .course-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0.85rem; }
  .course-card { display: grid; align-content: start; padding: 1.3rem; color: inherit; text-decoration: none; transition: border-color 0.15s ease, transform 0.15s ease; }
  .course-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .course-index { color: var(--signal); font-size: 0.68rem; }
  .course-card h3 { margin-top: 0.75rem; font-size: var(--step-1); }
  .course-card p { margin-top: 0.65rem; color: var(--ink-soft); font-size: 0.9rem; }
  .course-link { align-self: end; margin-top: 1rem; color: var(--accent); font-size: 0.78rem; font-weight: 650; }
  .methods { display: grid; grid-template-columns: minmax(14rem,0.65fr) minmax(0,1fr); gap: 2rem; padding: clamp(1.5rem,4vw,2.5rem); background: var(--signal-soft); border: 1px solid var(--rule); }
  .methods h2 { margin-top: 0.45rem; font-size: var(--step-2); }
  .methods ul { list-style: none; padding: 0; border-top: 1px solid var(--rule); }
  .methods li { padding: 0.65rem 0; border-bottom: 1px solid var(--rule); color: var(--ink-soft); }
  @media (max-width: 44rem) { .course-grid, .methods { grid-template-columns: 1fr; } }
</style>
