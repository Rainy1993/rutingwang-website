---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { publications, workingPapers } from '../data/publications';
import { site } from '../data/site';

const featured = publications.filter((pub) => pub.featured);
const journals = publications.filter((pub) => pub.category === 'journal');
const other = publications.filter((pub) => pub.category !== 'journal');
const description = `Selected publications and CV-based research record for ${site.name}, with verified DOI links.`;
---
<BaseLayout title="Publications" description={description}>
  <div class="page-shell">
    <div class="container">
      <section class="content-block selected" aria-labelledby="selected-title">
        <header class="section-heading"><div><p class="eyebrow">Short selection</p><h2 id="selected-title">Selected publications</h2></div></header>
        <div>{featured.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>

      <section class="content-block" aria-labelledby="journal-title">
        <header class="section-heading"><div><p class="eyebrow">Published record</p><h2 id="journal-title">Journal articles</h2></div></header>
        <div>{journals.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>

      <section class="content-block" aria-labelledby="other-title">
        <header class="section-heading"><div><p class="eyebrow">Books &amp; conferences</p><h2 id="other-title">Other outputs</h2></div></header>
        <div>{other.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>

      <section class="content-block" aria-labelledby="pipeline-title">
        <header class="section-heading"><div><p class="eyebrow">Ongoing research</p><h2 id="pipeline-title">Working papers &amp; work in progress</h2></div></header>
        <div>{workingPapers.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>
    </div>
  </div>
</BaseLayout>
