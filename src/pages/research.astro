---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import TalksSection from '../components/TalksSection.astro';
import { researchThemes, grants } from '../data/research';
import { workingPapers } from '../data/publications';
import { site } from '../data/site';

const description = `Research by ${site.name} on systemic risk, digital assets, climate finance, corporate finance and machine learning.`;
---
<BaseLayout title="Research" description={description}>
  <div class="page-shell">
    <div class="container">
      <PageIntro index="R / 01" eyebrow="Research programme" title="Research" summary="A programme at the intersection of financial risk, digital markets, climate finance and data-driven methods."/>

      <section class="themes content-block" aria-labelledby="themes-title">
        <header class="section-heading"><div><p class="eyebrow">Themes</p><h2 id="themes-title">Research areas</h2></div></header>
        <ul class="theme-list" role="list">
          {researchThemes.map((theme) => (
            <li id={`theme-${theme.ref}`}>
              <div><h3>{theme.title}</h3><p>{theme.summary}</p><ul class="tag-list" role="list">{theme.topics.map((topic) => <li class="tag">{topic}</li>)}</ul></div>
            </li>
          ))}
        </ul>
      </section>

      <section class="content-block" aria-labelledby="grants-title">
        <header class="section-heading"><div><p class="eyebrow">Funded research</p><h2 id="grants-title">Projects as principal investigator</h2></div><p class="section-note">Three competitively funded projects listed in the July 2026 CV.</p></header>
        <div class="grant-list">
          {grants.map((grant) => (
            <article class="grant"><div class="grant-meta"><span class="mono">{grant.period}</span><span>{grant.role}</span></div><div><p class="grant-funder">{grant.funder} · {grant.id}</p><h3>{grant.title}</h3></div></article>
          ))}
        </div>
      </section>

      <section class="content-block" aria-labelledby="working-title">
        <header class="section-heading"><div><p class="eyebrow">Current pipeline</p><h2 id="working-title">Research in progress</h2></div><p class="section-note">Titles and review status are reported as they appear in the CV; journal names indicate the current review destination, not publication.</p></header>
        <div class="working-grid">
          {workingPapers.map((paper) => (
            <article class="work-card card"><p class="mono work-status">{paper.status}</p><h3>{paper.href ? <a class="text-link" href={paper.href} target="_blank" rel="noopener noreferrer">{paper.title}<span class="visually-hidden"> (opens in a new tab)</span></a> : paper.title}</h3><p>{paper.authors}</p><p class="work-venue">{paper.venue}</p></article>
          ))}
        </div>
      </section>

      <TalksSection/>
    </div>
  </div>
</BaseLayout>

<style>
  .themes { margin-top: var(--section); }
  .theme-list { border-top: 1px solid var(--rule); }
  .theme-list > li { padding: clamp(1.65rem,3.5vw,2.5rem) clamp(0rem,2.2vw,1.5rem); border-bottom: 1px solid var(--rule); scroll-margin-top: var(--header-offset); }
  .theme-list h3 { max-width: 36ch; font-size: clamp(1.35rem,1.25rem + 0.48vw,1.65rem); font-weight: 570; letter-spacing: -0.012em; line-height: 1.3; }
  .theme-list p { max-width: 63ch; margin-top: 0.65rem; color: var(--ink-soft); font-size: 0.97rem; line-height: 1.65; }
  .theme-list .tag-list { margin-top: 1.05rem; }
  .grant-list { border-top: 1px solid var(--rule); }
  .grant { display: grid; grid-template-columns: 12rem minmax(0,1fr); gap: clamp(1.2rem,4vw,3rem); padding-block: 1.6rem; border-bottom: 1px solid var(--rule); }
  .grant-meta { display: grid; align-content: start; gap: 0.25rem; color: var(--muted); font-size: 0.75rem; }
  .grant-meta .mono { color: var(--signal); }
  .grant-funder { color: var(--copper); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .grant h3 { max-width: 49ch; margin-top: 0.45rem; font-size: var(--step-1); line-height: 1.35; }
  .working-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0.85rem; }
  .work-card { padding: 1.25rem; }
  .work-status { color: var(--copper); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .work-card h3 { margin-top: 0.55rem; font-size: 1.08rem; line-height: 1.33; }
  .work-card > p:nth-last-child(2) { margin-top: 0.65rem; color: var(--ink-soft); font-size: 0.84rem; }
  .work-venue { margin-top: 0.25rem; color: var(--muted); font-family: var(--font-serif); font-size: 0.9rem; font-style: italic; }
  @media (max-width: 46rem) { .working-grid { grid-template-columns: 1fr; } .grant { grid-template-columns: 1fr; gap: 0.6rem; } }
</style>
