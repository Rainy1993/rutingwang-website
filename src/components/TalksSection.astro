---
import talks from '../data/talks.json';
const hasTalks = talks.items.length > 0;
interface Props { showEmpty?: boolean }
const { showEmpty = false } = Astro.props;
---
{(hasTalks || showEmpty) && (
  <section id="talks" class="content-block" aria-labelledby="talks-title">
    <header class="section-heading"><div><p class="eyebrow">Presentations</p><h2 id="talks-title">Talks archive</h2></div></header>
    {hasTalks ? (
      <div class="timeline">
        {talks.items.map((talk) => (
          <article class="timeline-item">
            <p class="mono timeline-date">{talk.date}</p>
            <div><h3>{talk.href ? <a class="text-link" href={talk.href} target="_blank" rel="noopener noreferrer">{talk.title}<span class="visually-hidden"> (opens in a new tab)</span></a> : talk.title}</h3><p>{talk.event} · {talk.venue}</p><p class="muted">{talk.kind}</p></div>
          </article>
        ))}
      </div>
    ) : <p class="talks-placeholder">Details forthcoming.</p>}
  </section>
)}

<style>
  .talks-placeholder { padding-block: 1.4rem; border-block: 1px solid var(--rule); color: var(--ink-soft); font-family: var(--font-serif); font-size: var(--step-1); }
</style>
