---
import type { Publication } from '../data/publications';
interface Props { publication: Publication; showYear?: boolean }
const { publication: pub, showYear = true } = Astro.props;
const href = pub.doi ? `https://doi.org/${pub.doi}` : pub.href;
const label = pub.category === 'journal' ? 'Journal article' : pub.category === 'book' ? 'Book' : pub.category === 'conference' ? 'Conference paper' : 'Working paper';
---

<article class="publication">
  {showYear && <time class="pub-year mono" datetime={String(pub.year)}>{pub.year}</time>}
  <div class="pub-topics" aria-label="Research topics">
    {pub.researchTopics.map((topic) => <span>{topic}</span>)}
  </div>
  <div class="pub-body">
    <p class="pub-type mono">{pub.status ?? label}</p>
    <h3>{href ? <a href={href} target="_blank" rel="noopener noreferrer">{pub.title}<span class="visually-hidden"> (opens in a new tab)</span></a> : pub.title}</h3>
    <p class="pub-authors">{pub.authors}</p>
    <p class="pub-source"><em>{pub.venue}</em>{pub.detail ? `, ${pub.detail}` : ''}.</p>
    {pub.note && <p class="pub-note">{pub.note}</p>}
    {href && <p class="pub-link"><a href={href} target="_blank" rel="noopener noreferrer">{pub.doi ? `DOI ${pub.doi}` : 'Open source'} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></p>}
  </div>
</article>

<style>
  .publication {
    display: grid;
    grid-template-columns: 4.4rem minmax(8.5rem, 11rem) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: 1.45rem;
    border-top: 1px solid var(--rule);
  }
  .publication:last-child { border-bottom: 1px solid var(--rule); }
  .pub-year { color: var(--signal); font-size: 0.78rem; letter-spacing: 0.05em; padding-top: 0.28rem; }
  .pub-topics { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 0.38rem; padding-top: 0.1rem; }
  .pub-topics span { border: 1px solid var(--rule); color: var(--accent); font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; line-height: 1.35; padding: 0.28rem 0.42rem; text-transform: uppercase; }
  .pub-body { min-width: 0; }
  .pub-type { font-size: 0.66rem; color: var(--copper); text-transform: uppercase; letter-spacing: 0.11em; margin-bottom: 0.35rem; }
  h3 { font-size: var(--step-1); line-height: 1.28; max-width: 42ch; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 1px; }
  .pub-authors { margin-top: 0.42rem; font-size: 0.9rem; color: var(--ink-soft); }
  .pub-source { margin-top: 0.25rem; font-family: var(--font-serif); color: var(--ink-soft); }
  .pub-note { margin-top: 0.55rem; max-width: 62ch; font-size: 0.82rem; color: var(--muted); border-left: 2px solid var(--signal); padding-left: 0.75rem; }
  .pub-link { margin-top: 0.6rem; }
  .pub-link a { font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent); overflow-wrap: anywhere; }
  @media (max-width: 32rem) {
    .publication { grid-template-columns: 1fr; gap: 0.2rem; }
    .pub-topics { padding-top: 0; }
  }
</style>
