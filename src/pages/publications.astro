---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { publications, workingPapers } from '../data/publications';
import { site } from '../data/site';

const featured = publications.filter((pub) => pub.featured);
const journals = publications.filter((pub) => pub.category === 'journal');
const other = publications.filter((pub) => pub.category !== 'journal');
const description = `Selected publications and CV-based research record for ${site.name}, with verified DOI links.`;
---
<BaseLayout title="Publications" description={description}>
  <div class="page-shell">
    <div class="container">
      <PageIntro index="P / 02" eyebrow="Research outputs" title="Publications" summary="Peer-reviewed articles, a forthcoming book, conference work and the current research pipeline. Published work and work under review are kept clearly separate."/>

      <section class="content-block selected" aria-labelledby="selected-title">
        <header class="section-heading"><div><p class="eyebrow">Short selection</p><h2 id="selected-title">Selected publications</h2></div><p class="section-note">Three international journal articles selected for their coverage of financial networks, digital assets and financial development.</p></header>
        <div>{featured.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>

      <section class="content-block" aria-labelledby="journal-title">
        <header class="section-heading"><div><p class="eyebrow">Published record</p><h2 id="journal-title">Journal articles</h2></div><p class="section-note">Seven articles listed in the July 2026 CV. DOI links are provided where verified; Chinese-language articles are left unlinked rather than pointed to unverified records.</p></header>
        <div>{journals.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>

      <section class="content-block" aria-labelledby="other-title">
        <header class="section-heading"><div><p class="eyebrow">Books &amp; conferences</p><h2 id="other-title">Other outputs</h2></div><p class="section-note">A forthcoming Springer Nature book and a conference paper reported in the CV.</p></header>
        <div>{other.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>

      <section class="content-block" aria-labelledby="pipeline-title">
        <header class="section-heading"><div><p class="eyebrow">Ongoing research</p><h2 id="pipeline-title">Working papers &amp; work in progress</h2></div><p class="section-note">Review destinations and statuses are current to the CV date and must not be read as publication claims.</p></header>
        <div>{workingPapers.map((pub) => <PublicationItem publication={pub}/>)}</div>
      </section>

      <aside class="record-note">
        <div><p class="eyebrow">Full record</p><h2>Independent databases</h2></div>
        <p>For citation updates and indexing, consult <a class="text-link" href="https://scholar.google.com/citations?user=tB0js94AAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>, <a class="text-link" href="https://orcid.org/0000-0001-8871-3838" target="_blank" rel="noopener noreferrer">ORCID</a> and <a class="text-link" href="https://www.researchgate.net/profile/Ruting-Wang" target="_blank" rel="noopener noreferrer">ResearchGate</a>.</p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .selected { margin-top: var(--section); }
  .record-note { display: grid; grid-template-columns: minmax(14rem,0.55fr) minmax(0,1fr); gap: 2rem; margin-top: var(--section); padding: clamp(1.4rem,4vw,2.5rem); border: 1px solid var(--rule); border-left: 3px solid var(--signal); background: var(--surface); }
  .record-note h2 { margin-top: 0.4rem; font-size: var(--step-2); }
  .record-note > p { align-self: center; max-width: 60ch; color: var(--ink-soft); }
  @media (max-width: 42rem) { .record-note { grid-template-columns: 1fr; } }
</style>
