---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import quantinarLogo from '../../logo/quantinar.png';
import quantletLogo from '../../logo/quantlet.png';

const teaching = [
  { period: 'August 2025', course: 'Machine Learning in Financial Risk', institution: 'Data without Borders: Building AI Competence across Borders · Romania', href: 'https://www.fabiz.ase.ro/bip-2025/', detail: 'Summer course' },
  { period: 'Feb–Sep 2021', course: 'DEDA — Digital Economy & Decision Analytics', institution: 'Humboldt-Universität zu Berlin', detail: '' },
  { period: 'Sep–Dec 2019', course: 'Probability Theory', institution: 'Sun Yat-sen University', detail: '' },
  { period: 'Sep–Dec 2019', course: 'Financial Markets and Financial Institutions', institution: 'Sun Yat-sen University', detail: '' },
];
const quantinar = [
  { title: 'Machine Learning in Financial Risk', description: 'Introduces VaR, Expected Shortfall, quantile regression and Lasso, then connects them through Financial Risk Meter applications.', href: 'https://quantinar.com/course/934/machine-learning-in-financial-risk' },
  { title: 'FRM@China', description: 'Develops FRM@China to detect systemic financial risk, tail-event dependence and risk drivers across major Chinese financial institutions.', href: 'https://www.quantinar.com/course/43/FRM' },
  { title: 'FRM@Crypto', description: 'Applies the Financial Risk Meter to cryptocurrencies and links the FRM index to pricing-kernel volatility and forward-looking risk.', href: 'https://quantinar.com/course/47/frmcrypto?q=FRM%20for%20Cryptos' },
  { title: 'Measuring Carbon Risk Dynamics', description: 'Develops CARDI, a Quantile-LASSO network indicator for carbon-risk transmission, volatility shifts and low-carbon premia.', href: 'https://quantinar.com/course/923/measuring-carbon-risk-dynamics?q=cardi' },
  { title: 'Market Responses to ETH Development Milestones', description: 'Studies how Ethereum upgrades affect returns, volatility and spillovers across the broader cryptocurrency market.', href: 'https://quantinar.com/course/857/market-responses-to-eth-development-milestones' },
  { title: 'Kalman Filter', description: 'Introduces Kalman filtering as a way to infer unobservable states from observable data, with applications to financial time-series prediction.', href: 'https://www.quantinar.com/course/42/methodology' },
  { title: 'Applied Time Series Analysis Solutions', description: 'Collects solution materials across time-series concepts, ARMA/ARIMA, nonstationarity, financial time series, state-space models and modern ML methods.', href: 'https://quantinar.com/course/853/applied-time-series-analysis-solutions-book?q=ATSSB' },
  { title: 'Pricing-kernel puzzle', description: 'Explains the empirical pricing-kernel puzzle by comparing risk-neutral and physical densities, preference implications and volatility-driven evidence.', href: 'https://quantinar.com/course/829/pricing-kernel-puzzles?q=pricing%20kernel%20puzzle' },
  { title: 'Quantile Regression', description: 'Introduces quantile regression for conditional distribution and tail analysis, covering asymmetric loss functions, estimation and empirical applications.', href: 'https://quantinar.com/course/732/quantile-regression?q=Quantile%20Regression' },
  { title: 'Expectation Maximisation (EM) algorithm', description: 'Explains the EM algorithm for maximum-likelihood estimation in probabilistic models with missing data or latent variables.', href: 'https://quantinar.com/course/747/expectation-maximization-em-algorithm?q=EM%20Algorithm' },
  { title: 'Bahadur, Edgeworth, Cornish-Fisher expansions', description: 'Covers Bahadur, Edgeworth and Cornish-Fisher expansions for improving normal approximations and quantile-based risk estimation.', href: 'https://quantinar.com/course/647/bahadur-edgeworth-cornish-fisher-expansions?q=Bahadur%2C%20Edgeworth%2C%20Cornish-Fisher%20expansions' },
  { title: 'Bootstrap and Jackknife', description: 'Introduces bootstrap and jackknife resampling methods for estimating bias, standard errors and uncertainty in statistical estimates.', href: 'https://quantinar.com/course/819/bootstrap-and-jackknife' },
  { title: 'How Much Power was Saved in ETH Merge?', description: 'Uses the Ethereum Merge as a natural experiment to measure cryptocurrency energy consumption with a hybrid framework.', href: 'https://quantinar.com/course/100026/how-much-power-was-saved-in-eth-merge' },
];
const description = `Teaching by ${site.name} in financial risk, machine learning, probability, financial markets and digital-economy analytics.`;
---
<BaseLayout title="Teaching" description={description}>
  <div class="page-shell">
    <div class="container">
      <section class="content-block teaching-block" aria-labelledby="experience-title">
        <header class="section-heading"><div><p class="eyebrow">Classroom</p><h2 id="experience-title">Teaching experience</h2></div></header>
        <div class="timeline">
          {teaching.map((item) => <article class="timeline-item"><p class="timeline-date mono">{item.period}</p><div><h3>{item.course}</h3><p>{item.href ? <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">{item.institution}<span class="visually-hidden"> (opens in a new tab)</span></a> : item.institution}</p>{item.detail && <p class="muted">{item.detail}</p>}</div></article>)}
        </div>
      </section>

      <section class="content-block" aria-labelledby="online-title">
        <header class="section-heading course-heading">
          <div><p class="eyebrow">Open learning</p><h2 id="online-title">Quantinar courses &amp; courselets</h2></div>
          <div class="learning-logos" aria-label="Learning platform links">
            <a href="https://quantinar.com/search?searchTerm=ruting+wang+" target="_blank" rel="noopener noreferrer">
              <img src={quantinarLogo.src} width={quantinarLogo.width} height={quantinarLogo.height} alt="Quantinar" loading="lazy" decoding="async" />
              <span class="visually-hidden">Quantinar search results for Ruting Wang (opens in a new tab)</span>
            </a>
            <a href="https://quantlet.com/SearchResult?query=ruting%20wang" target="_blank" rel="noopener noreferrer">
              <img src={quantletLogo.src} width={quantletLogo.width} height={quantletLogo.height} alt="Quantlet" loading="lazy" decoding="async" />
              <span class="visually-hidden">Quantlet search results for Ruting Wang (opens in a new tab)</span>
            </a>
          </div>
        </header>
        <div class="course-grid">
          {quantinar.map((course, index) => (
            <a class="course-card card" href={course.href} target="_blank" rel="noopener noreferrer">
              <span class="course-index mono">Q / {String(index + 1).padStart(2, '0')}</span><h3>{course.title}</h3><p>{course.description}</p><span class="course-link">Open course <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .course-heading { align-items: end; gap: 1.2rem; }
  .learning-logos { display: flex; align-items: center; justify-content: flex-end; gap: 0.8rem; }
  .learning-logos a { display: flex; align-items: center; justify-content: center; width: 6.2rem; height: 4.4rem; border: 1px solid var(--rule); background: var(--surface); transition: border-color 0.15s ease, transform 0.15s ease; }
  .learning-logos a:hover { border-color: var(--accent); transform: translateY(-1px); }
  .learning-logos img { display: block; width: auto; max-width: 4.7rem; max-height: 3.2rem; object-fit: contain; }
  .course-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0.85rem; }
  .course-card { display: grid; align-content: start; padding: 1.3rem; color: inherit; text-decoration: none; transition: border-color 0.15s ease, transform 0.15s ease; }
  .course-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .course-index { color: var(--signal); font-size: 0.68rem; }
  .course-card h3 { margin-top: 0.75rem; font-size: var(--step-1); }
  .course-card p { margin-top: 0.65rem; color: var(--ink-soft); font-size: 0.9rem; }
  .course-link { align-self: end; margin-top: 1rem; color: var(--accent); font-size: 0.78rem; font-weight: 650; }
  @media (max-width: 44rem) {
    .course-heading { align-items: start; }
    .learning-logos { justify-content: flex-start; }
    .course-grid { grid-template-columns: 1fr; }
  }
</style>
