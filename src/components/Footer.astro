---
import ProfileIcon from './ProfileIcon.astro';
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-identity">
      <p class="footer-name">{site.name}</p>
      <p class="footer-zh" lang="zh-Hans">{site.nameZh}</p>
      <p>{site.role}</p>
      <p class="footer-muted">{site.affiliation}</p>
    </div>
    <nav aria-label="Footer navigation">
      <p class="footer-label">Sections</p>
      <ul role="list">{site.nav.map((item) => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}</ul>
    </nav>
    <div>
      <p class="footer-label">Contact</p>
      <ul role="list">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`mailto:${site.emailSecondary}`}>{site.emailSecondary}</a></li>
        <li><a href={`${base}/docs/ruting-wang-short-cv.pdf`} target="_blank" rel="noopener noreferrer">Short CV (PDF)</a></li>
        <li><a href={`${base}/docs/ruting-wang-full-cv.pdf`} target="_blank" rel="noopener noreferrer">Full CV (PDF)</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Academic profiles</p>
      <ul class="footer-profiles" role="list">
        {site.profiles.slice(0, 4).map((profile) => (
          <li><a href={profile.href} target="_blank" rel="me noopener noreferrer"><ProfileIcon name={profile.icon}/><span>{profile.short}</span><span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="container footer-base">
    <span>© 2026 Dr. {site.name}. All rights reserved.</span>
    <a href="https://jsinsights.co.uk/services/academic-websites/" target="_blank" rel="noopener noreferrer">Academic website by JS Insights <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
  </div>
</footer>
