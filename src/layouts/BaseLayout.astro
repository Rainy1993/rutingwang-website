---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; fullTitle?: string; type?: 'website' | 'profile' | 'article'; noindex?: boolean }
const { title, description, fullTitle, type, noindex } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head><BaseHead {title} {description} {fullTitle} {type} {noindex}/></head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader/>
    <main id="main"><slot/></main>
    <Footer/>
  </body>
</html>
