---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileIcon from '../components/ProfileIcon.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { site, appointments, education } from '../data/site';
import { researchThemes } from '../data/research';
import { publications } from '../data/publications';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = publications.filter((pub) => pub.featured);
const description = `${site.name} is a finance researcher working on financial risk, digital assets, climate finance, corporate finance and machine learning.`;
---

<BaseLayout title={site.name} fullTitle={`${site.name} — Finance researcher`} description={description} type="profile">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1><span class="hero-name">{site.name}</span></h1>
        <p class="hero-role">{site.role}</p>
        <p class="hero-affiliation">{site.affiliation}</p>
        <p class="hero-lede">{site.summary}</p>
        <div class="button-row hero-buttons">
          <a class="button" href={`${base}/research`}>Explore research <span aria-hidden="true">→</span></a>
          <a class="button secondary" href={`${base}/publications`}>View publications</a>
          <a class="button secondary" href={`${base}/docs/ruting-wang-cv.pdf`} target="_blank" rel="noopener noreferrer">CV <span aria-hidden="true">↓</span><span class="visually-hidden"> (PDF, opens in a new tab)</span></a>
        </div>
      </div>

      <aside class="hero-aside" aria-label="Portrait and academic profiles">
        <div class="portrait-wrap">
          <img src={`${base}/images/ruting-wang-portrait.webp`} width="724" height="1086" alt="Ruting Wang" fetchpriority="high" />
        </div>
        <nav class="profile-row" aria-label="Academic profiles">
          {site.profiles.slice(0, 4).map((profile) => (
            <a href={profile.href} target="_blank" rel="me noopener noreferrer" aria-label={`${profile.label} (opens in a new tab)`}>
              <ProfileIcon name={profile.icon}/><span>{profile.short}</span>
            </a>
          ))}
        </nav>
      </aside>
    </div>
  </section>

  <section class="index-strip" aria-labelledby="focus-title">
    <div class="container focus-grid">
      <div class="focus-heading">
        <p id="focus-title" class="eyebrow">Research index</p>
      </div>
      <ol class="focus-list" role="list">
        {researchThemes.map((theme) => (
          <li><span class="mono">{theme.ref}</span><a href={`${base}/research#theme-${theme.ref}`}>{theme.title}</a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="profile-title">
    <div class="container profile-grid">
      <div class="profile-copy">
        <h2 id="profile-title">About me</h2>
        <div class="prose">
          <p>I received my Ph.D. in Finance from Sun Yat-sen University (SYSU) in 2022. In 2021, I was a visiting Ph.D. researcher with the Ladislaus von Bortkiewicz Chair of Statistics at <a class="text-link" href="https://www.hu-berlin.de/en/forschungsinformationssystem/projekt-details/grk-1792-hochdimensionale-nicht-stationaere-zeitreihen" target="_blank" rel="noopener noreferrer">Humboldt-Universität zu Berlin (HUB)</a>.</p>
          <p>I am currently affiliated with the <a class="text-link" href="https://www.cityu.edu.hk/see_eeem/index.html" target="_blank" rel="noopener noreferrer">Laboratory of Energy Economics and Environmental Management</a> (E3M) at City University of Hong Kong (CityU) and the Business School of Sun Yat-sen University. I am also a member of the <a class="text-link" href="http://theIDA.net" target="_blank" rel="noopener noreferrer">IDA Institute of Digital Assets</a> and the <a class="text-link" href="https://www.digital-finance-msca.com" target="_blank" rel="noopener noreferrer">MSCA Digital Finance</a> research network.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="selected-title">
    <div class="container">
      <header class="section-heading">
        <div><p class="eyebrow">Selected work</p><h2 id="selected-title">Published research</h2></div>
      </header>
      <div>{featured.map((pub) => <PublicationItem publication={pub}/>)}</div>
      <div class="button-row section-action"><a class="button secondary" href={`${base}/publications`}>Complete record <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="path-title">
    <div class="container">
      <header class="section-heading">
        <div><p class="eyebrow">Academic path</p><h2 id="path-title">Appointments &amp; education</h2></div>
        <p class="section-note">Current appointments and degrees, drawn from the current CV.</p>
      </header>
      <div class="path-grid">
        <div>
          <h3 class="path-label">Appointments</h3>
          <div class="timeline">
            {appointments.map((item) => (
              <article class="timeline-item"><p class="timeline-date mono">{item.period}</p><div><h3>{item.role}</h3><p>{item.organisation}</p>{item.detail && <p class="muted">{item.detail}</p>}</div></article>
            ))}
          </div>
        </div>
        <div>
          <h3 class="path-label">Education</h3>
          <div class="timeline">
            {education.map((item) => (
              <article class="timeline-item"><p class="timeline-date mono">{item.period}</p><div><h3>{item.degree}</h3><p>{item.institution}</p>{item.detail && <p class="muted dissertation">{item.detail}</p>}</div></article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-band">
    <div class="container contact-band-grid">
      <div><p class="eyebrow">Contact</p><h2>Research collaboration and academic enquiries</h2></div>
      <div><p>For questions about current work in financial risk, digital assets, climate finance or machine learning.</p><div class="button-row"><a class="button" href={`mailto:${site.email}`}>Email Ruting</a><a class="button secondary" href={`${base}/contact`}>All contact details</a></div></div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 6vw, 6.5rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.7fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .hero-copy h1 { max-width: 100%; font-size: clamp(2.35rem, 1.75rem + 2.4vw, 3.85rem); }
  .hero-copy h1 .hero-name { display: inline-block; white-space: nowrap; }
  .hero-role { margin-top: 1.6rem; color: var(--accent-deep); font-family: var(--font-serif); font-size: var(--step-2); font-weight: 600; }
  .hero-affiliation { margin-top: 0.25rem; color: var(--muted); font-size: 0.9rem; }
  .hero-lede { max-width: 50ch; margin-top: 1.45rem; color: var(--ink-soft); text-align: justify; }
  .hero-buttons { margin-top: 2rem; }
  .hero-aside { max-width: 25rem; justify-self: end; }
  .portrait-wrap { border: 1px solid var(--rule); background: var(--surface); padding: 0.65rem; box-shadow: var(--shadow); }
  .portrait-wrap img { width: 100%; aspect-ratio: 2 / 2.55; object-fit: cover; object-position: 50% 30%; filter: saturate(0.84) contrast(1.02); }
  .profile-row { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 0.45rem; margin-top: 0.7rem; }
  .profile-row a { display: grid; justify-items: center; gap: 0.32rem; padding: 0.6rem 0.25rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface); color: var(--muted); font-size: 0.64rem; font-weight: 600; text-decoration: none; }
  .profile-row a:hover { border-color: var(--accent); color: var(--accent); }
  .profile-row :global(.profile-icon) { width: 1.8rem; height: 1.8rem; flex-basis: 1.8rem; }
  .index-strip { background: var(--night); color: #d8d3d8; border-block: 3px solid #305e69; padding-block: clamp(1.5rem, 3vw, 2.2rem); }
  .focus-grid { display: grid; gap: 0.85rem; align-items: start; }
  .focus-heading .eyebrow { color: #9dcbd4; }
  .focus-list { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0; border-top: 1px solid rgba(255,255,255,0.15); }
  .focus-list li { display: grid; grid-template-columns: 2rem minmax(0,1fr); gap: 0.7rem; align-items: baseline; padding: 0.72rem 0; border-bottom: 1px solid rgba(255,255,255,0.15); }
  .focus-list li:nth-child(odd) { padding-right: 1rem; }
  .focus-list li:nth-child(even) { padding-left: 1rem; border-left: 1px solid rgba(255,255,255,0.15); }
  .focus-list span { color: #82b4bf; font-size: 0.68rem; }
  .focus-list a { color: #d8d3d8; font-size: 0.86rem; text-decoration: none; }
  .focus-list a:hover { color: #fff; }
  .profile-grid { display: grid; grid-template-columns: 1fr; }
  .profile-copy h2 { max-width: 19ch; }
  .profile-copy .prose { margin-top: 1.5rem; }
  .section-action { margin-top: 2rem; }
  .path-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: clamp(2rem,5vw,4rem); }
  .path-label { margin-bottom: 0.7rem; color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .path-grid .timeline-item { grid-template-columns: 6.5rem minmax(0,1fr); }
  .dissertation { max-width: 52ch; }
  .contact-band { padding-block: clamp(3rem,6vw,5rem); background: var(--signal-soft); border-top: 1px solid var(--rule); }
  .contact-band-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(18rem,0.8fr); gap: clamp(2rem,6vw,5rem); align-items: center; }
  .contact-band h2 { max-width: 19ch; margin-top: 0.5rem; }
  .contact-band-grid > div:last-child > p { color: var(--ink-soft); margin-bottom: 1.3rem; }
  @media (max-width: 52rem) {
    .hero-grid, .profile-grid, .contact-band-grid { grid-template-columns: 1fr; }
    .hero-aside { justify-self: start; width: min(100%, 24rem); }
    .path-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 40rem) {
    .focus-list { grid-template-columns: 1fr; }
    .focus-list li:nth-child(odd), .focus-list li:nth-child(even) { padding-inline: 0; border-left: 0; }
  }
  @media (max-width: 25rem) { .profile-row { grid-template-columns: repeat(2,1fr); } }
</style>
