---
import talks from '../data/talks.json';
const hasTalks = talks.items.length > 0;
interface Props { showEmpty?: boolean }
const { showEmpty = false } = Astro.props;
---
{(hasTalks || showEmpty) && (
  <section id="talks" class="content-block" aria-labelledby="talks-title">
    <header class="section-heading"><div><p class="eyebrow">Presentations</p><h2 id="talks-title">Talks archive</h2></div></header>
    {hasTalks ? (
      <div class="timeline">
        {talks.items.map((talk) => (
          <article class="timeline-item">
            <p class="mono timeline-date">{talk.date}</p>
            <div class="talk-details">
              <h3>{talk.href ? <a class="text-link" href={talk.href} target="_blank" rel="noopener noreferrer">{talk.title}<span class="visually-hidden"> (opens in a new tab)</span></a> : talk.title}</h3>
              <p>{talk.event} · {talk.venue}</p>
              <p class="muted">{[talk.kind, talk.time, talk.language].filter(Boolean).join(' · ')}</p>
              {talk.summary && <p class="talk-summary">{talk.summary}</p>}
              {(talk.host || talk.admission || talk.onlineHref) && (
                <p class="talk-meta">
                  {talk.host && <span>Host: {talk.host}</span>}
                  {talk.admission && <span>{talk.admission}</span>}
                  {talk.onlineHref && <a class="text-link" href={talk.onlineHref} target="_blank" rel="noopener noreferrer">Join online<span class="visually-hidden"> (opens in a new tab)</span></a>}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : <p class="talks-placeholder">Details forthcoming.</p>}
  </section>
)}

<style>
  .talks-placeholder { padding-block: 1.4rem; border-block: 1px solid var(--rule); color: var(--ink-soft); font-family: var(--font-serif); font-size: var(--step-1); }
  .talk-details { display: grid; gap: 0.35rem; }
  .talk-summary { max-width: 62ch; margin-top: 0.15rem; color: var(--ink-soft); }
  .talk-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 0.75rem; color: var(--muted); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.02em; }
  .talk-meta span:not(:last-child)::after { content: ""; }
</style>
